<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#064E3B"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tvIncomingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Incoming Chutki Voice Call"
        android:textColor="#A7F3D0"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ivRiderAvatar"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="28dp"
        android:background="#047857"
        android:contentDescription="Rider Profile Photo"
        android:padding="20dp"
        android:src="@android:drawable/sym_def_app_icon" />

    <TextView
        android:id="@+id/tvCallerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Delivery Rider"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOrderBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Order #12345"
        android:textColor="#D1FAE5"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnDeclineCall"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:backgroundTint="#DC2626"
            android:text="Decline"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAnswerCall"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:backgroundTint="#10B981"
            android:text="Answer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
