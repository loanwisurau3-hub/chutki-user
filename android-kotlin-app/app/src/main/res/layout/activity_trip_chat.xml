<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECE5DD"
    android:orientation="vertical">

    <!-- WhatsApp-style Chutki Green Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#059669"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBackChat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:backgroundTint="#047857"
            android:text="←"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatRiderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Rider"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatPresence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online • Order #12345"
                android:textColor="#D1FAE5"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHeaderVoiceCall"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#047857"
            android:text="Call Rider"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="20dp"
        android:text="No messages yet. Send delivery instructions to your assigned Chutki Rider."
        android:textColor="#475569"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />

    <!-- Bottom Message Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@android:drawable/edit_text"
            android:hint="Message Rider (Phone numbers hidden)..."
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#059669"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
